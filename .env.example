# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...            # key from the "job-radar" workspace in the Claude Console
NOTION_TOKEN=ntn_...                     # Notion internal integration token (shared with the tracker DB)
NOTION_DATABASE_ID=d2c0fa46a231491cbe754cbf5abf272e   # Master Job Tracker — Live

# Models (defaults shown)
RADAR_MODEL_FILTER=claude-haiku-5-5
RADAR_MODEL_SCORE=claude-opus-5-5   # best F1 + bullet faithfulness in evals/compare_models.py
RADAR_MODEL_JUDGE=claude-fable-5-1

# Guards (budget mode: $1.50 and 40 postings per daily run)
# RADAR_FIT_THRESHOLD=50      # min score to file; unset = config/tuning.json (monthly retune), else 50
RADAR_MAX_SCORED=40           # max postings sent to the scoring model per run
RADAR_MAX_RUN_USD=1.50        # hard stop for one run

# Local-first (Davis / Sacramento area)
RADAR_LOCAL_BONUS=10          # local matches are filed at fit_threshold - this
RADAR_LOCAL_SHARE=0.6         # max share of a run's 40 slots local postings take while remote ones wait

# Feedback loop
RADAR_FEW_SHOT=12             # recent Applied/Skipped decisions added to the scorer prompt (0 = off)

# Polite fetching (Workday 429s)
RADAR_WORKDAY_WORKERS=3       # Workday requests in flight, across all tenants
RADAR_WORKDAY_RPS=5           # Workday request starts per second, across all tenants
RADAR_ICIMS_MAX_DETAIL=40     # iCIMS job pages fetched per run (national boards)

# Weekly summary
# NOTION_SUMMARY_PARENT_ID=36cd76e3aa8a81449216c5cd87bc751c   # Job Search Command Center (default)
# RADAR_MONTHLY_BUDGET_USD=200
