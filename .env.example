# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...            # key from a dedicated workspace in the Claude Console (set a spend limit there)
NOTION_TOKEN=ntn_...                     # Notion internal integration token, connected to your tracker database
NOTION_DATABASE_ID=                      # printed by: python -m job_radar init-notion --parent <page>; blank = config/profile.yaml

# Cost preset. Pick one block; the Lite block is the default for new users.
# Lite  (~$0.05 per run, ~$1.50/mo):  Haiku filters AND scores. F1 0.75 on the author's labels.
# Best  (~$1.50 per run, ~$45/mo):    Haiku filters, Opus scores. F1 0.79-0.81, most faithful bullets.
RADAR_MODEL_FILTER=claude-haiku-5-5
RADAR_MODEL_SCORE=claude-haiku-5-5      # Best preset: claude-opus-5-5 (what the author runs)
RADAR_MODEL_JUDGE=claude-haiku-5-5      # Best preset: claude-opus-5-5 (checks drafts for invented claims)

# Guards
RADAR_FIT_THRESHOLD=50        # min score (0-100) to file in Notion; set from the eval threshold sweep
RADAR_MAX_SCORED=40           # max postings sent to the scoring model per run
RADAR_MAX_RUN_USD=0.50        # hard stop for one run (Best preset: 1.50)

# Optional
# RADAR_PROFILE_PATH=config/profile.yaml   # who the radar searches for; copy a lane pack over it
# RADAR_RESUME_PATH=data/resume.md         # local resume (gitignored); CI uses the RESUME_MD secret
